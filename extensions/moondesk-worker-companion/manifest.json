{
  "manifest_version": 3,
  "name": "MoonDesk Worker Companion (Experimental)",
  "version": "0.1.0",
  "description": "Experimental MoonDesk companion for durable ChatGPT worker launches.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "action": {
    "default_title": "MoonDesk Worker Companion",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["chatgpt-dom.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
